# Copy to .env and fill in your key. .env is git-ignored.
ANTHROPIC_API_KEY=sk-ant-...

# Model used by `ask`, `chat` and `eval` unless --model is given.
CLAUDE_MODEL=claude-sonnet-5-5

# Local Postgres from docker-compose.yml. The agent roles are created by `fulfillment-agent setup`.
ADMIN_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/fulfillment
AGENT_RO_DATABASE_URL=postgresql://agent_ro:agent_ro@localhost:5432/fulfillment
AGENT_RW_DATABASE_URL=postgresql://agent_writer:agent_writer@localhost:5432/fulfillment
